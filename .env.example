# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Text LLM configuration for SCITAS HPC inference
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
MODEL_BASE_URL=http://localhost:8000/v1

# Vision-Language Model for scanned PDF extraction (served via vLLM on SCITAS)
VLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
VLM_BASE_URL=http://localhost:8001/v1

# PII anonymization settings
PRESIDIO_SCORE_THRESHOLD=0.35
GLINER_MODEL=urchade/gliner_multi_pii-v1
