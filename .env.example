# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Text LLM configuration for SCITAS HPC inference
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
MODEL_BASE_URL=http://localhost:8000/v1

# Vision-Language Model for scanned PDF extraction (served via vLLM on SCITAS)
VLM_MODEL_NAME=reducto/RolmOCR
VLM_BASE_URL=http://localhost:8001/v1

# PII anonymization settings
PRESIDIO_SCORE_THRESHOLD=0.5
GLINER_MODEL=knowledgator/gliner-multitask-large-v0.5

# Entity types to exclude from anonymization (comma-separated).
# LOCATION and NRP are preserved because international experience matters.
# organization is preserved because institution names signal in reference letters.
# Street addresses are now redacted as <ADDRESS>. LOCATION (city/country) stays visible.
ANONYMIZER_EXCLUDED_ENTITIES_RAW=LOCATION,NRP,organization,ORGANIZATION

# Zero Entropy API (letter retrieval via zsearch)
ZEROENTROPY_API_KEY=ze-...
ZEROENTROPY_COLLECTION=mte-reference-letters

# OpenRouter (calibration profile generation)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Output directories
CALIBRATION_PROFILES_DIR=data/processed/calibration_profiles
EVALUATION_OUTPUT_DIR=data/processed/evaluations
